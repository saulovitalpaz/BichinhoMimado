// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User (System Users: Admin, Vet, Receptionist)
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         String   // 'admin', 'veterinarian', 'receptionist'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AuditLog[]
  stockMovements StockMovement[]
}

// Audit Log for tracking all changes
model AuditLog {
  id        Int      @id @default(autoincrement())
  table     String
  recordId  Int
  action    String   // 'CREATE', 'UPDATE', 'DELETE', 'SOFT_DELETE'
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  changes   String?  // JSON string of changes
  ipAddress String?  // LGPD Compliance
  userAgent String?  // LGPD Compliance
  timestamp DateTime @default(now())
}

// Tutor (Client)
model Tutor {
  id          Int      @id @default(autoincrement())
  name        String
  cpf         String?
  email       String?
  phone       String?
  address     String?
  number      String?
  neighborhood String?
  city        String?
  state       String?
  zipCode     String?
  lgpdConsent Boolean  @default(false)
  legacyId    String?  @unique // ID from Excel
  observations String?
  patients    Pet[]
  bills       Bill[]
  appointments Appointment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft Delete

  @@index([deletedAt])
}

model Pet {
  id             Int             @id @default(autoincrement())
  name           String
  species        String
  breed          String?
  gender         String?         // 'M' or 'F'
  weight         Float?
  birthDate      DateTime?
  microchip      String?
  tags           String?
  legacyId       String?         // ID from Excel
  observations   String?
  tutorId        Int
  tutor          Tutor           @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  medicalRecords MedicalRecord[]
  appointments   Appointment[]
  invoiceItems   InvoiceItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?       // Soft Delete

  @@index([deletedAt])
}

model MedicalRecord {
  id             Int            @id @default(autoincrement())
  date           DateTime       @default(now())
  petId          Int
  pet            Pet            @relation(fields: [petId], references: [id])
  veterinarian   String?        // Name of the vet
  chiefComplaint String?        // Queixa principal
  
  // SOAP Structure (JSON or distinct fields)
  soapData       String?        // JSON: { subjective, objective, assessment, plan }
  
  // Specific fields if needed outside JSON
  diagnosis      String?        // Text or JSON with CID codes
  treatment      String?        // Text plan
  
  prescriptions  Prescription[]
  status         String         @default("Open") // Open, Finalized
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?      // Soft Delete
  
  @@index([deletedAt])
}

model Prescription {
  id              Int           @id @default(autoincrement())
  medicalRecordId Int
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  productId       Int?
  product         Product?      @relation(fields: [productId], references: [id])
  medicationName  String        // If not in stock/product list
  dosage          String
  frequency       String
  duration        String
  notes           String?
}

model Appointment {
  id        Int      @id @default(autoincrement())
  date      DateTime
  type      String   // Clinical, Petshop
  service   String?  // 'Banho', 'Tosa', 'Consulta'
  status    String   // Scheduled, CheckedIn, InProgress, Completed, Canceled
  
  // Petshop specific workflow
  petshopStatus String? // 'Aguardando', 'Banho', 'Secagem', 'Tosa', 'Finalizacao', 'Pronto'
  groomer       String? // Profissional responsável

  petId     Int?
  pet       Pet?     @relation(fields: [petId], references: [id], onDelete: Cascade)

  tutorId   Int?
  tutor     Tutor?   @relation(fields: [tutorId], references: [id])
  
  serviceId Int?
  serviceRef Service? @relation(fields: [serviceId], references: [id])

  invoiceItem InvoiceItem?

  price     Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft Delete

  @@index([deletedAt])
}

model Product {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  sku           String?        @unique
  category      String?        // Medications, Petshop, Food
  stock         Int            @default(0)
  minStock      Int            @default(5)
  costPrice     Float?
  salePrice     Float
  expiry        DateTime?
  
  // Fiscal Data
  ncm           String?        // Nomenclatura Comum do Mercosul
  cfop          String?        // Código Fiscal de Operações
  taxRate       Float?         // Alíquota aproximada impostos
  
  prescriptions Prescription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?      // Soft Delete
  stockMovements StockMovement[]

  @@index([deletedAt])
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  type      String   // 'ENTRY', 'EXIT', 'ADJUSTMENT'
  quantity  Int
  reason    String?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Bill {
  id            Int           @id @default(autoincrement())
  description   String?
  amount        Float
  dueDate       DateTime
  paidDate      DateTime?
  paymentMethod String?       // Credit, Debit, Cash, Pix
  type          String        @default("Receivable") // Receivable (Receita), Payable (Despesa)
  status        String        // Paid, Pending, Overdue
  installments  Int           @default(1)
  taxAmount     Float?        @default(0.0)
  netAmount     Float?        // amount - taxAmount
  
  tutorId       Int?
  tutor         Tutor?        @relation(fields: [tutorId], references: [id])
  
  category      String?       // 'Clinical', 'Petshop', 'Retail', 'Operational'
  items         InvoiceItem[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?     // Soft Delete
  
  @@index([deletedAt])
}

model DailyCashFlow {
  id             Int      @id @default(autoincrement())
  date           DateTime @unique @default(now()) // Only one per day ideally, or handle by shifts
  openingBalance Float
  closingBalance Float?
  status         DailyCashFlowStatus @default(OPEN)
  notes          String?
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum TransactionStatus {
  PENDING
  PAID
  REFUNDED
  OVERDUE
}

enum Role {
  ADMIN
  VETERINARIAN
  RECEPTIONIST
}

enum DailyCashFlowStatus {
  OPEN
  CLOSED
}

// Unified Invoice Item (Clinical, Petshop, PDV)
model InvoiceItem {
  id          Int             @id @default(autoincrement())
  billId      Int
  bill        Bill            @relation(fields: [billId], references: [id])
  category    InvoiceCategory
  description String
  amount      Float
  costAmount  Float?          // Snapshot of cost at time of sale
  quantity    Int             @default(1)
  
  petId       Int?
  pet         Pet?            @relation(fields: [petId], references: [id])
  
  serviceId   Int?
  service     Service?        @relation(fields: [serviceId], references: [id])

  appointmentId Int?          @unique
  appointment Appointment?    @relation(fields: [appointmentId], references: [id])

  createdAt   DateTime        @default(now())
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  tradeName   String?  // Nome Fantasia
  cnpj        String   @unique
  ie          String?  // Inscrição Estadual
  crt         String?  // Código de Regime Tributário (1=Simples, 3=Normal)
  
  address     String?
  number      String?
  neighborhood String?
  city        String?
  state       String?  // UF (2 chars)
  zipCode     String?
  phone       String?
  email       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum InvoiceCategory {
  CLINICAL
  PETSHOP
  PDV
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  sku         String?  @unique
  price       Float
  duration    Int      @default(30) // in minutes
  category    String   // 'Petshop', 'Clinical'
  active      Boolean  @default(true)
  
  // Fiscal Data
  iss         Float?   // Alíquota ISS
  taxRate     Float?   // Alíquota aproximada
  
  appointments Appointment[]
  invoiceItems InvoiceItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft Delete
}

model Professional {
  id        Int      @id @default(autoincrement())
  name      String
  role      String   // 'Veterinarian', 'Groomer', 'Clerk'
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft Delete
}

model Goal {
  id        Int      @id @default(autoincrement())
  type      String   @unique // 'DAILY', 'WEEKLY', 'MONTHLY'
  value     Float
  updatedAt DateTime @updatedAt
}
